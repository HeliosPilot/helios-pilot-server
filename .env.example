TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me

GROQ_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me

GITHUB_APP_ID=replace-me
GITHUB_PRIVATE_KEY=replace-me
GITHUB_WEBHOOK_SECRET=replace-me

SENTRY_DSN=replace-me
# Optional: 0.0 to 1.0, defaults to 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

DASHBOARD_TOKEN=replace-me
# Required for GET /api?cron=true (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace-me

KV_REST_API_URL=replace-me
KV_REST_API_TOKEN=replace-me
# Upstash names are also supported:
# UPSTASH_REDIS_REST_URL=replace-me
# UPSTASH_REDIS_REST_TOKEN=replace-me
